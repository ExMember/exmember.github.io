source 'https://rubygems.org'

gem 'jekyll', '~>4.2.2' # newer releases use too much from USWDS

# Old versions of jekyll assume these are built-in because they were with old
# versions of ruby
gem 'csv'
gem 'base64'

gem 'uswds-jekyll'

gem 'html-proofer'
gem 'jekyll-autoprefixer'
gem 'mini_racer'

gem 'webrick'
gem 'nokogiri'

group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-remote-theme'
end
